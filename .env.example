# EXEMPLO FICTICIO: substituir os marcadores por enderecos legitimos.
# Este arquivo NAO e carregado automaticamente pelo aplicativo.
# Defina as variaveis no processo do terminal antes de iniciar o Streamlit.
# Nao incluir senhas, tokens ou credenciais nos enderecos.

# Necessaria para login.
XANO_AUTH_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_AUTENTICACAO

# Necessarias para utilizar os respectivos modulos.
XANO_CLIENTES_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_CLIENTES
XANO_EQUIPAMENTOS_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_EQUIPAMENTOS
XANO_TECNICOS_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_TECNICOS
XANO_ORDENS_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_ORDENS
XANO_SERVICOS_API_BASE_URL=SUBSTITUIR_PELO_ENDERECO_HTTPS_DE_SERVICOS

# Opcional: manter desabilitada na configuracao de exemplo.
# Ativar somente mediante verificacao e autorizacao do responsavel.
XANO_EQUIPAMENTOS_DELETE_VALIDATED=false
